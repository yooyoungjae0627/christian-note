 "learning": {
  "summary": [
   {
    "text": "라헬은 자식을 낳지 못하자 언니 레아를 시기하며 야곱에게 자식을 달라고 했습니다.",
    "verse": "30:1",
    "u": [
     "언니 레아를 시기하며"
    ]
   },
   {
    "text": "야곱은 자기가 하나님을 대신하겠느냐며 화를 냈습니다.",
    "verse": "30:2",
    "u": [
     "하나님을 대신하겠느냐며"
    ]
   },
   {
    "text": "라헬의 하녀 빌하가 단과 납탈리를, 레아의 하녀 질파가 갓과 아셸을 낳았습니다.",
    "verse": "30:8",
    "u": [
     "단과 납탈리를",
     "갓과 아셸을"
    ]
   },
   {
    "text": "유대인, 곧 이스라엘 민족의 정의는 야곱과 열두 아들부터 나옵니다.",
    "key": "g30-1",
    "u": [
     "야곱과 열두 아들부터"
    ]
   },
   {
    "text": "아브라함에게 주신 약속이 이삭을 거쳐 야곱과 열두 아들에게 이어졌습니다.",
    "key": "g30-2",
    "u": [
     "야곱과 열두 아들에게"
    ]
   },
   {
    "text": "어머니가 이방인이어도 아버지가 유대인이면 유대인으로 보듯, 남편이 의인이면 아내도 의인입니다.",
    "key": "g30-3",
    "u": [
     "남편이 의인이면 아내도 의인"
    ]
   },
   {
    "text": "레아는 아들의 합환채로 야곱을 빌려 잇사칼을 낳았고, 이어 스불룬과 디나를 낳았습니다.",
    "verse": "30:18",
    "u": [
     "잇사칼을 낳았고"
    ]
   },
   {
    "text": "하나님께서 라헬을 기억하시고 태를 열어 주셔서 요셉이 태어났습니다.",
    "verse": "30:22",
    "u": [
     "태를 열어 주셔서"
    ]
   },
   {
    "text": "라헬은 신약에서도 교회의 상징으로 쓰입니다.",
    "key": "g30-4",
    "u": [
     "교회의 상징"
    ]
   },
   {
    "text": "라헬의 첫째 아들 요셉은 장자권을 받아 두 지파의 몫을 갖게 되었습니다.",
    "key": "g30-5",
    "u": [
     "두 지파의 몫"
    ]
   },
   {
    "text": "라반은 야곱 때문에 주께서 자기에게 복을 주신 것을 경험으로 배웠다고 말했습니다.",
    "verse": "30:27",
    "u": [
     "경험으로 배웠다고"
    ]
   },
   {
    "text": "하나님께서 함께하시는 사람이 있는 곳은 그곳도 복을 받습니다.",
    "key": "g30-6",
    "u": [
     "그곳도 복을 받습니다"
    ]
   },
   {
    "text": "그 궁극적인 이유는 하나님께서 복의 근원이시기 때문입니다.",
    "key": "g30-7",
    "u": [
     "복의 근원"
    ]
   },
   {
    "text": "야곱은 얼룩무늬와 점박이와 갈색인 가축을 품값으로 정했습니다.",
    "verse": "30:32",
    "u": [
     "품값으로 정했습니다"
    ]
   },
   {
    "text": "야곱은 껍질 벗긴 가지를 물통 앞에 두었고, 힘센 가축은 야곱의 것이 되었습니다.",
    "verse": "30:42",
    "u": [
     "힘센 가축은 야곱의 것"
    ]
   },
   {
    "text": "야곱은 지극히 융성하여 많은 가축과 종과 낙타와 나귀를 가지게 되었습니다.",
    "verse": "30:43",
    "u": [
     "지극히 융성하여"
    ]
   }
  ],
  "glossary": [
   {
    "term": "합환채",
    "verse": "30:14",
    "text": "르우벤이 밀 수확 때 밭에서 발견하여 어머니 레아에게 가져온 것입니다."
   },
   {
    "term": "유대인(혈통)",
    "key": "g30-1",
    "text": "1차적으로 혈통에 관한 말. 야곱과 열두 아들, 그리고 아브라함과 이삭부터 정의됩니다."
   },
   {
    "term": "남편이 의인이면 의인",
    "key": "g30-3",
    "text": "아버지가 유대인이면 그 아들을 유대인으로 보듯, 예수님과 결혼한 우리도 의인으로 보신다는 원리입니다."
   },
   {
    "term": "장자권",
    "key": "g30-5",
    "text": "라헬의 첫째 아들 요셉이 받은 것. 그래서 므낫세와 에프라임 두 지파의 몫을 갖게 되었습니다."
   },
   {
    "term": "복의 근원",
    "key": "g30-7",
    "text": "하나님. 하나님께서 함께하시는 사람이 있는 곳이 복을 받는 궁극적인 이유입니다."
   },
   {
    "term": "품삯(품값)",
    "verse": "30:32",
    "text": "야곱이 라반의 양 떼를 먹이는 대가로 정한 것. 얼룩무늬와 점박이와 갈색인 가축이었습니다."
   }
  ]
 },
